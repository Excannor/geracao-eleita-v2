  "paradas": [
    {
      "n": 1,
      "lugar": "cesareia",
      "nome": "Cesareia",
      "texto": "Paulo e outros presos embarcam sob a guarda do centurião Júlio.",
      "ref": "At 27.1-2"
    },
    {
      "n": 2,
      "lugar": "sidom",
      "nome": "Sidom",
      "texto": "Júlio deixa Paulo descer para visitar os amigos.",
      "ref": "At 27.3"
    },
    {
      "n": 3,
      "lugar": "mirra",
      "nome": "Mirra",
      "texto": "Com vento contrário, passam ao norte de Chipre. Em Mirra, trocam para um navio que ia de Alexandria à Itália.",
      "ref": "At 27.4-6"
    },
    {
      "n": 4,
      "lugar": "cnido",
      "nome": "Cnido",
      "texto": "Depois de dias de navegação difícil, o vento não os deixa seguir.",
      "ref": "At 27.7"
    },
    {
      "n": 5,
      "lugar": "bons-portos",
      "nome": "Salmona e Bons Portos",
      "texto": "Eles descem pelo sul de Creta. Paulo avisa que seguir viagem é perigoso.",
      "ref": "At 27.7-12"
    },
    {
      "n": 6,
      "lugar": "tempestade",
      "nome": "A tempestade",
      "texto": "Quatorze dias à deriva. O navio se parte, mas todos chegam vivos à praia.",
      "ref": "At 27.13-44"
    },
    {
      "n": 7,
      "lugar": "malta",
      "nome": "Malta",
      "texto": "Uma cobra prende-se à mão de Paulo, e nada lhe acontece. O pai de Públio e outros doentes são curados.",
      "ref": "At 28.1-10"
    },
    {
      "n": 8,
      "lugar": "siracusa",
      "nome": "Siracusa",
      "texto": "Três meses depois, num navio de Alexandria, ficam três dias em Siracusa.",
      "ref": "At 28.11-12"
    },
    {
      "n": 9,
      "lugar": "regio",
      "nome": "Régio",
      "texto": "Contornam a ponta da Itália e esperam o vento sul.",
      "ref": "At 28.13"
    },
    {
      "n": 10,
      "lugar": "poteoli",
      "nome": "Potéoli",
      "texto": "Encontram irmãos e ficam com eles uma semana.",
      "ref": "At 28.13-14"
    },
    {
      "n": 11,
      "lugar": "forum",
      "nome": "Fórum de Ápio e Três Vendas",
      "texto": "Irmãos de Roma vêm ao encontro de Paulo, e ele dá graças a Deus.",
      "ref": "At 28.15"
    },
    {
      "n": 12,
      "lugar": "roma",
      "nome": "Roma",
      "texto": "Paulo mora dois anos numa casa alugada, sob guarda, e anuncia o Reino de Deus a todos que vão visitá-lo.",
      "ref": "At 28.16-31"
    }
  ],

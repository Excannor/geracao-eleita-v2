  "paradas": [
    {
      "n": 1,
      "lugar": "antioquia",
      "nome": "Antioquia da Síria",
      "texto": "Paulo e Barnabé se separam. Paulo escolhe Silas e parte, enquanto Barnabé leva Marcos para Chipre.",
      "ref": "At 15.36-40"
    },
    {
      "n": 2,
      "lugar": "tarso",
      "nome": "Síria e Cilícia",
      "texto": "Eles passam pelas igrejas da Síria e da Cilícia, animando os irmãos.",
      "ref": "At 15.41"
    },
    {
      "n": 3,
      "lugar": "derbe",
      "nome": "Derbe",
      "texto": "Paulo e Silas voltam primeiro a Derbe.",
      "ref": "At 16.1"
    },
    {
      "n": 4,
      "lugar": "listra",
      "nome": "Listra",
      "texto": "Timóteo, respeitado pelos irmãos, entra no grupo.",
      "ref": "At 16.1-3"
    },
    {
      "n": 5,
      "lugar": "iconio",
      "nome": "Icônio",
      "texto": "De cidade em cidade, as igrejas ficam mais firmes e crescem a cada dia.",
      "ref": "At 16.2-5"
    },
    {
      "n": 6,
      "lugar": "antioquia-pisidia",
      "nome": "Frígia e Galácia",
      "texto": "O Espírito Santo não deixa que preguem na Ásia nem que entrem na Bitínia.",
      "ref": "At 16.6-7"
    },
    {
      "n": 7,
      "lugar": "troade",
      "nome": "Trôade",
      "texto": "À noite, Paulo vê um homem da Macedônia pedindo ajuda.",
      "ref": "At 16.8-10"
    },
    {
      "n": 8,
      "lugar": [
        "samotracia",
        "neapolis"
      ],
      "nome": "Samotrácia e Neápolis",
      "texto": "De Trôade, eles navegam direto para a Samotrácia e, no dia seguinte, para Neápolis.",
      "ref": "At 16.11"
    },
    {
      "n": 9,
      "lugar": "filipos",
      "nome": "Filipos",
      "texto": "Lídia crê. Na prisão, Paulo e Silas cantam, a terra treme, e o carcereiro é batizado com a família.",
      "ref": "At 16.12-40"
    },
    {
      "n": 10,
      "lugar": "tessalonica",
      "nome": "Tessalônica",
      "texto": "Passando por Anfípolis e Apolônia, eles pregam três sábados na sinagoga. Muitos creem, e há tumulto na cidade.",
      "ref": "At 17.1-9"
    },
    {
      "n": 11,
      "tipo": "volta",
      "lugar": "bereia",
      "nome": "Bereia",
      "texto": "O povo examina as Escrituras todos os dias para ver se o que Paulo diz é verdade.",
      "ref": "At 17.10-14"
    },
    {
      "n": 12,
      "tipo": "volta",
      "lugar": "atenas",
      "nome": "Atenas",
      "texto": "Paulo fala do Deus desconhecido no Areópago. Dionísio e Dâmaris creem.",
      "ref": "At 17.15-34"
    },
    {
      "n": 13,
      "tipo": "volta",
      "lugar": "corinto",
      "nome": "Corinto",
      "texto": "Paulo mora e trabalha com Áqüila e Priscila e ensina ali um ano e meio.",
      "ref": "At 18.1-17"
    },
    {
      "n": 14,
      "tipo": "volta",
      "lugar": "cencreia",
      "nome": "Cencreia",
      "texto": "Antes de embarcar, Paulo rapa a cabeça por causa de um voto.",
      "ref": "At 18.18"
    },
    {
      "n": 15,
      "tipo": "volta",
      "lugar": "efeso",
      "nome": "Éfeso",
      "texto": "Priscila e Áqüila ficam. Paulo promete voltar, se Deus quiser.",
      "ref": "At 18.19-21"
    },
    {
      "n": 16,
      "tipo": "volta",
      "lugar": "cesareia",
      "nome": "Cesareia",
      "texto": "Do porto, Paulo sobe para saudar a igreja de Jerusalém.",
      "ref": "At 18.22"
    },
    {
      "n": 17,
      "tipo": "volta",
      "lugar": "antioquia",
      "nome": "Antioquia da Síria",
      "texto": "Paulo volta à igreja que o enviou.",
      "ref": "At 18.22"
    }
  ],

  "paradas": [
    {
      "n": 1,
      "lugar": "ruben",
      "nome": "Rúben",
      "texto": "Recebe de Moisés as terras a leste do mar Morto. O Jordão é a fronteira do oeste.",
      "ref": "Js 13.15-23"
    },
    {
      "n": 2,
      "lugar": "gade",
      "nome": "Gade",
      "texto": "Fica com parte de Gileade, a leste do Jordão.",
      "ref": "Js 13.24-28"
    },
    {
      "n": 3,
      "lugar": "manasses-l",
      "nome": "Manassés (a leste do Jordão)",
      "texto": "Metade da tribo recebe Basã e metade de Gileade, ao norte.",
      "ref": "Js 13.29-31"
    },
    {
      "n": 4,
      "lugar": "juda",
      "nome": "Judá",
      "texto": "A maior parte, do mar Morto ao Mediterrâneo. Os jebuseus continuam em Jerusalém.",
      "ref": "Js 15.1-63"
    },
    {
      "n": 5,
      "lugar": "efraim",
      "nome": "Efraim",
      "texto": "O centro da terra. Os cananeus de Gezer continuam no meio do povo.",
      "ref": "Js 16.5-10"
    },
    {
      "n": 6,
      "lugar": "manasses-o",
      "nome": "Manassés (a oeste do Jordão)",
      "texto": "A outra metade da tribo de Manassés, filho mais velho de José, fica a oeste do Jordão.",
      "ref": "Js 17.1-13"
    },
    {
      "n": 7,
      "lugar": "benjamim",
      "nome": "Benjamim",
      "texto": "Uma faixa entre Judá e José, com Jebus, que é Jerusalém.",
      "ref": "Js 18.11-28"
    },
    {
      "n": 8,
      "lugar": "simeao",
      "nome": "Simeão",
      "texto": "Recebe cidades dentro da herança de Judá, que era grande demais para uma tribo só.",
      "ref": "Js 19.1-9"
    },
    {
      "n": 9,
      "lugar": "zebulom",
      "nome": "Zebulom",
      "texto": "O terceiro sorteio, na Galileia.",
      "ref": "Js 19.10-16"
    },
    {
      "n": 10,
      "lugar": "issacar",
      "nome": "Issacar",
      "texto": "O quarto sorteio, ao sul do mar da Galileia.",
      "ref": "Js 19.17-23"
    },
    {
      "n": 11,
      "lugar": "aser",
      "nome": "Aser",
      "texto": "O quinto sorteio, junto ao litoral do norte.",
      "ref": "Js 19.24-31"
    },
    {
      "n": 12,
      "lugar": "naftali",
      "nome": "Naftali",
      "texto": "O sexto sorteio, a oeste do mar da Galileia e do Jordão.",
      "ref": "Js 19.32-39"
    },
    {
      "n": 13,
      "lugar": "da",
      "nome": "Dã",
      "texto": "O sétimo sorteio, perto do litoral, entre Judá e Efraim.",
      "ref": "Js 19.40-48"
    }
  ],

  "paradas": [
    {
      "n": 1,
      "lugar": "sitim",
      "nome": "Sitim",
      "texto": "Josué e o povo levantam o acampamento e vão até o Jordão.",
      "ref": "Js 3.1"
    },
    {
      "n": 2,
      "lugar": "gilgal",
      "nome": "Gilgal",
      "texto": "As águas param, o povo atravessa sem molhar os pés, e Josué levanta as doze pedras.",
      "ref": "Js 3.14–4.20"
    },
    {
      "n": 3,
      "lugar": "jerico",
      "nome": "Jericó",
      "texto": "Depois de sete dias de marcha, as cornetas tocam e os muros caem.",
      "ref": "Js 6.1-27"
    },
    {
      "n": 4,
      "lugar": "ai",
      "nome": "Ai",
      "texto": "Israel perde a primeira batalha por causa do pecado de Acã. Depois, toma a cidade.",
      "ref": "Js 7.1–8.29"
    },
    {
      "n": 5,
      "lugar": "gibeom",
      "nome": "Gibeom",
      "texto": "Josué defende os gibeonitas, e o sol para até a vitória.",
      "ref": "Js 9.3–10.14"
    },
    {
      "n": 6,
      "lugar": "azeca",
      "nome": "Azeca e Maquedá",
      "texto": "Os inimigos fogem sob uma chuva de pedras. Os cinco reis se escondem numa caverna em Maquedá.",
      "ref": "Js 10.10-28"
    },
    {
      "n": 7,
      "lugar": "libna",
      "nome": "Libna",
      "texto": "Josué ataca Libna.",
      "ref": "Js 10.29-30"
    },
    {
      "n": 8,
      "lugar": "laquis",
      "nome": "Láquis",
      "texto": "A cidade é cercada e cai no segundo dia.",
      "ref": "Js 10.31-33"
    },
    {
      "n": 9,
      "lugar": "eglom",
      "nome": "Eglom",
      "texto": "Josué sitia e toma Eglom.",
      "ref": "Js 10.34-35"
    },
    {
      "n": 10,
      "lugar": "hebrom",
      "nome": "Hebrom",
      "texto": "Israel sobe de Eglom e ataca Hebrom.",
      "ref": "Js 10.36-37"
    },
    {
      "n": 11,
      "lugar": "debir",
      "nome": "Debir",
      "texto": "Josué volta-se contra Debir e a toma.",
      "ref": "Js 10.38-39"
    },
    {
      "n": 12,
      "tipo": "volta",
      "lugar": "gilgal",
      "nome": "Gilgal",
      "texto": "Josué volta com todo o Israel para o acampamento.",
      "ref": "Js 10.43"
    }
  ],

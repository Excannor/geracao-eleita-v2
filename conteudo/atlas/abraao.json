  "paradas": [
    {
      "n": 1,
      "lugar": "ur",
      "nome": "Ur dos caldeus",
      "texto": "Terá sai de Ur com Abrão, Sarai e Ló, a caminho de Canaã.",
      "ref": "Gn 11.31"
    },
    {
      "n": 2,
      "lugar": "hara",
      "nome": "Harã",
      "texto": "A família para em Harã. Ali Deus chama Abrão, que parte aos 75 anos.",
      "ref": "Gn 11.31–12.5"
    },
    {
      "n": 3,
      "lugar": "siquem",
      "nome": "Siquém",
      "texto": "Junto ao carvalho de Moré, Deus promete a terra, e Abrão levanta um altar.",
      "ref": "Gn 12.6-7"
    },
    {
      "n": 4,
      "lugar": "betel",
      "nome": "Betel e Ai",
      "texto": "Abrão acampa entre Betel e Ai, levanta outro altar e ora ao Senhor.",
      "ref": "Gn 12.8"
    },
    {
      "n": 5,
      "lugar": "neguebe",
      "nome": "Neguebe",
      "texto": "Ele segue para o sul. Numa fome, desce ao Egito e depois volta até Betel.",
      "ref": "Gn 12.9–13.4"
    },
    {
      "n": 6,
      "lugar": "hebrom",
      "nome": "Hebrom",
      "texto": "Abrão acampa junto aos carvalhos de Manre, perto de Hebrom, e levanta um altar.",

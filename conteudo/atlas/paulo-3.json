  "paradas": [
    {
      "n": 1,
      "lugar": "antioquia",
      "nome": "Antioquia da Síria",
      "texto": "Depois de algum tempo em Antioquia, Paulo parte outra vez.",
      "ref": "At 18.23"
    },
    {
      "n": 2,
      "lugar": "galacia",
      "nome": "Galácia e Frígia",
      "texto": "Ele passa de cidade em cidade animando os irmãos.",
      "ref": "At 18.23"
    },
    {
      "n": 3,
      "lugar": "efeso",
      "nome": "Éfeso",
      "texto": "Paulo ensina dois anos na escola de Tirano, e toda a Ásia ouve a palavra. Depois vem o tumulto na cidade.",
      "ref": "At 19.1-41"
    },
    {
      "n": 4,
      "lugar": "tessalonica",
      "nome": "Macedônia",
      "texto": "Paulo percorre a região e anima os irmãos de cidade em cidade.",
      "ref": "At 20.1-2"
    },
    {
      "n": 5,
      "lugar": "corinto",
      "nome": "Grécia",
      "texto": "Ele fica três meses. Por causa de uma conspiração, decide voltar pela Macedônia.",
      "ref": "At 20.2-3"
    },
    {
      "n": 6,
      "tipo": "volta",
      "lugar": "filipos",
      "nome": "Filipos",
      "texto": "Depois da festa dos pães sem fermento, eles embarcam em Filipos.",
      "ref": "At 20.3-6"
    },
    {
      "n": 7,
      "tipo": "volta",
      "lugar": "troade",
      "nome": "Trôade",
      "texto": "Paulo fala até a meia-noite. Êutico cai da janela e volta vivo.",
      "ref": "At 20.6-12"
    },
    {
      "n": 8,
      "tipo": "volta",
      "lugar": "assos",
      "nome": "Assôs",
      "texto": "Paulo vai por terra e embarca com os outros em Assôs.",
      "ref": "At 20.13-14"
    },
    {
      "n": 9,
      "tipo": "volta",
      "lugar": "mitilene",
      "nome": "Mitilene, Quios e Samos",
      "texto": "Eles navegam até Mitilene e, nos dias seguintes, passam por Quios e Samos.",
      "ref": "At 20.14-15"
    },
    {
      "n": 10,
      "tipo": "volta",
      "lugar": "mileto",
      "nome": "Mileto",
      "texto": "Paulo se despede dos presbíteros de Éfeso. Eles oram juntos e choram.",
      "ref": "At 20.15-38"
    },
    {
      "n": 11,
      "tipo": "volta",
      "lugar": "rodes",
      "nome": "Cós, Rodes e Pátara",
      "texto": "Em Pátara, eles tomam um navio para a Fenícia.",
      "ref": "At 21.1-2"
    },
    {
      "n": 12,
      "tipo": "volta",
      "lugar": "tiro",
      "nome": "Tiro",
      "texto": "Deixando Chipre à esquerda, eles chegam a Tiro e ficam sete dias com os discípulos.",
      "ref": "At 21.3-6"
    },
    {
      "n": 13,
      "tipo": "volta",
      "lugar": "ptolemaida",
      "nome": "Ptolemaida",
      "texto": "Saúdam os irmãos e ficam só um dia.",
      "ref": "At 21.7"
    },
    {
      "n": 14,
      "tipo": "volta",
      "lugar": "cesareia",
      "nome": "Cesareia",
      "texto": "Ficam na casa do evangelista Filipe. O profeta Ágabo avisa o que espera Paulo em Jerusalém.",
      "ref": "At 21.8-14"
    },
    {
      "n": 15,
      "tipo": "volta",
      "lugar": "jerusalem",
      "nome": "Jerusalém",
      "texto": "Os irmãos os recebem com muita alegria.",
      "ref": "At 21.15-17"
    }
  ],

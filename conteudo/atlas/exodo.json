  "paradas": [
    {
      "n": 1,
      "lugar": "ramesses",
      "nome": "Ramessés",
      "texto": "Saem do Egito cerca de seiscentos mil homens a pé, além de mulheres e crianças.",
      "ref": "Êx 12.37"
    },
    {
      "n": 2,
      "lugar": "sucote",
      "nome": "Sucote e Etã",
      "texto": "Eles acampam na entrada do deserto.",
      "ref": "Êx 13.20"
    },
    {
      "n": 3,
      "lugar": "migdol",
      "nome": "Pi-Hairote, entre Migdol e o mar",
      "texto": "Deus abre o mar Vermelho, e o povo atravessa em terra seca.",
      "ref": "Êx 14.1-31"
    },
    {
      "n": 4,
      "lugar": "mara",
      "nome": "Mara",
      "texto": "A água amarga fica boa para beber.",
      "ref": "Êx 15.22-26"
    },
    {
      "n": 5,
      "lugar": "elim",
      "nome": "Elim",
      "texto": "Acampam junto a doze fontes e setenta palmeiras.",
      "ref": "Êx 15.27"
    },
    {
      "n": 6,
      "lugar": "sim",
      "nome": "Deserto de Sim",
      "texto": "Deus manda o maná todas as manhãs.",
      "ref": "Êx 16.1-36"
    },
    {
      "n": 7,
      "lugar": "refidim",
      "nome": "Refidim",
      "texto": "Sai água da rocha, e Israel vence Amaleque.",
      "ref": "Êx 17.1-16"
    },
    {
      "n": 8,
      "lugar": "sinai",
      "nome": "Monte Sinai",
      "texto": "Deus faz aliança com o povo e dá os Dez Mandamentos.",
      "ref": "Êx 19.1–20.17"
    },
    {
      "n": 9,
      "lugar": "cades",
      "nome": "Cades-Barneia",
      "texto": "Os espiões voltam de Canaã, o povo tem medo de entrar, e começam os quarenta anos no deserto.",
      "ref": "Nm 13.26–14.35"
    },
    {
      "n": 10,
      "lugar": "eziom",
      "nome": "Eziom-Geber",
      "texto": "Passando por Jotbatá, acampam junto ao golfo.",
      "ref": "Nm 33.33-35"
    },
    {
      "n": 11,
      "lugar": "punom",
      "nome": "Punom",
      "texto": "Contornando Edom, eles sobem para o norte.",
      "ref": "Nm 33.42-43"
    },
    {
      "n": 12,
      "lugar": "moabe",
      "nome": "Campinas de Moabe",
      "texto": "Acampam junto ao Jordão, do outro lado de Jericó, diante da terra prometida.",
      "ref": "Nm 33.48-49"
    }
  ],

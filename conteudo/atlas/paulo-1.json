  "paradas": [
    { "n": 1, "lugar": "antioquia", "nome": "Antioquia da Síria", "texto": "Depois de jejuar e orar, a igreja impõe as mãos sobre Barnabé e Saulo e os envia.", "ref": "At 13.1-3" },
    { "n": 2, "lugar": "seleucia", "nome": "Selêucia", "texto": "Eles descem até o porto e embarcam para Chipre.", "ref": "At 13.4" },
    { "n": 3, "lugar": "salamina", "nome": "Salamina", "texto": "Pregam nas sinagogas, com João Marcos de ajudante.", "ref": "At 13.5" },
    { "n": 4, "lugar": "pafos", "nome": "Pafos", "texto": "O feiticeiro Elimas fica cego, e o governador Sérgio Paulo crê.", "ref": "At 13.6-12" },
    { "n": 5, "lugar": "perge", "nome": "Perge", "texto": "João Marcos deixa o grupo e volta para Jerusalém.", "ref": "At 13.13" },
    { "n": 6, "lugar": "antioquia-pisidia", "nome": "Antioquia da Pisídia", "texto": "Paulo prega na sinagoga. Muitos gentios creem, e os líderes expulsam os dois da cidade.", "ref": "At 13.14-50" },
    { "n": 7, "lugar": "iconio", "nome": "Icônio", "texto": "Muita gente crê. Quando planejam apedrejá-los, eles fogem.", "ref": "At 13.51–14.5" },
    { "n": 8, "lugar": "listra", "nome": "Listra", "texto": "Um homem que nunca tinha andado fica de pé. Depois, Paulo é apedrejado e se levanta.", "ref": "At 14.6-20" },
    { "n": 9, "lugar": "derbe", "nome": "Derbe", "texto": "Eles anunciam a boa-nova e fazem muitos discípulos.", "ref": "At 14.20-21" },
    { "n": 10, "tipo": "volta", "lugar": ["listra", "iconio", "antioquia-pisidia"], "nome": "Listra, Icônio e Antioquia", "texto": "Voltam pelas mesmas cidades, animam os discípulos e nomeiam presbíteros em cada igreja.", "ref": "At 14.21-23" },
    { "n": 11, "tipo": "volta", "lugar": "perge", "nome": "Perge", "texto": "Atravessam a Pisídia e pregam outra vez em Perge.", "ref": "At 14.24-25" },
    { "n": 12, "tipo": "volta", "lugar": "atalia", "nome": "Atália", "texto": "No porto de Atália, embarcam de volta.", "ref": "At 14.25-26" },
    { "n": 13, "tipo": "volta", "lugar": "antioquia", "nome": "Antioquia da Síria", "texto": "Reúnem a igreja e contam como Deus abriu a porta da fé aos gentios.", "ref": "At 14.26-28" }
  ],
